rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single-tier access: any signed-in user is a full Admin.
    function isSignedIn() {
      return request.auth != null;
    }

    // Public read-only content
    match /gallery/{id}      { allow read: if true; allow write: if isSignedIn(); }
    match /events/{id}       { allow read: if true; allow write: if isSignedIn(); }
    match /programs/{id}     { allow read: if true; allow write: if isSignedIn(); }
    match /testimonials/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /team/{id}         { allow read: if true; allow write: if isSignedIn(); }

    // Public can create, only signed-in admins can read/manage
    match /contacts/{id}      { allow create: if true; allow read, update, delete: if isSignedIn(); }
    match /feedback/{id}      { allow create: if true; allow read, update, delete: if isSignedIn(); }
    match /registrations/{id} { allow create: if true; allow read, update, delete: if isSignedIn(); }
    match /donations/{id}     { allow create: if true; allow read: if isSignedIn(); }
    match /volunteers/{id}    { allow create: if true; allow read: if isSignedIn(); }

    // Admin-only
    match /users/{id}       { allow read, write: if isSignedIn(); }
    match /activityLog/{id} { allow read, write: if isSignedIn(); }
  }
}
